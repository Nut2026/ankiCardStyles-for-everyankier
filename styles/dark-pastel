/*
Dark pastel with 20% margin on the left and 20% margin on the right.
Decorative half-borders on the Front: top-left and bottom-right, Back: top-right and bottom-left corners.
*/

html, body {
  margin: 0 !important;
  padding: 0 !important;
  height: 100%;
  width: 100%;
  overflow: auto;
  background: #0f1419 !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
}

#qa, .card, .card1, .card2, .card3 {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 0 !important;
  max-width: none !important;
  width: 100% !important;
  height: 100% !important;
}

.bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: #0f1419;
  background: linear-gradient(
    135deg,
    #0f1419 0%,
    #1a2332 40%,
    #1e2d3d 70%,
    #16202e 100%
  );
}

.card-wrapper {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 24px 20%;
  box-sizing: border-box;
}

.pastel-card {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 180px;
  padding: 40px 44px;
  box-sizing: border-box;

  background: #1e2a3a;
  background: linear-gradient(
    145deg,
    #1e2a3a 0%,
    #223040 50%,
    #1a2634 100%
  );

  border-radius: 28px;
  border: 1px solid rgba(100, 140, 190, 0.12);

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.45),
    0 6px 16px rgba(0, 0, 0, 0.30),
    inset 0 1px 0 rgba(140, 180, 220, 0.06);

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.pastel-card::before,
.pastel-card::after {
  content: "";
  position: absolute;
  width: 70px;
  height: 70px;
  pointer-events: none;
  box-sizing: border-box;

  border: 4px solid transparent;
}

.pastel-card.front::before {
  top: 0;
  left: 0;
  border-top-color: #2d8a9e;
  border-left-color: #2d8a9e;
  border-top-left-radius: 28px;
  border-bottom-right-radius: 0;
  -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
          mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
}

.pastel-card.front::after {
  bottom: 0;
  right: 0;
  border-bottom-color: #2d5a9e;
  border-right-color: #2d5a9e;
  border-bottom-right-radius: 28px;
  border-top-left-radius: 0;
  -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
          mask-image: linear-gradient(to top, #000 0%, transparent 100%);
}

.pastel-card.back::before {
  top: 0;
  right: 0;
  border-top-color: #5a5a6a;
  border-right-color: #5a5a6a;
  border-top-right-radius: 28px;
  border-bottom-left-radius: 0;
  -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
          mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
}

.pastel-card.back::after {
  bottom: 0;
  left: 0;
  border-bottom-color: #e07a3a;
  border-left-color: #e07a3a;
  border-bottom-left-radius: 28px;
  border-top-right-radius: 0;
  -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
          mask-image: linear-gradient(to top, #000 0%, transparent 100%);
}

.pastel-card .edge-top,
.pastel-card .edge-bottom {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 90px;
  height: 4px;
  pointer-events: none;
  border-radius: 4px;
  z-index: 1;
}

.pastel-card .edge-top {
  top: 0;
  background: #2d8a9e;
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    #000 50%,
    transparent 100%
  );
          mask-image: linear-gradient(
    to right,
    transparent 0%,
    #000 50%,
    transparent 100%
  );
}

.pastel-card .edge-bottom {
  bottom: 0;
  background: #2d5a9e;
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    #000 50%,
    transparent 100%
  );
          mask-image: linear-gradient(
    to right,
    transparent 0%,
    #000 50%,
    transparent 100%
  );
}

.pastel-card.back .edge-top    { background: #5a5a6a; }
.pastel-card.back .edge-bottom { background: #e07a3a; }

.content {
  font-size: 24px;
  line-height: 1.5;
  color: #dce6f0;
  text-align: center;
  font-weight: 500;
  letter-spacing: -0.01em;
  word-wrap: break-word;
  overflow-wrap: break-word;
  max-width: 100%;
}

.content.answer {
  font-size: 22px;
  color: #a8b8ca;
  font-weight: 400;
}

img {
  max-width: 100%;
  border-radius: 16px;
  margin-top: 12px;
}

@media (prefers-color-scheme: dark) {
  html, body {
    background: #0a0f14 !important;
  }
  .bg {
    background: #0a0f14;
    background: linear-gradient(
      135deg,
      #0a0f14 0%,
      #141e2a 40%,
      #182636 70%,
      #101a24 100%
    );
  }
  .pastel-card {
    background: #1a2636;
    background: linear-gradient(
      145deg,
      #1a2636 0%,
      #1e2c3e 50%,
      #162230 100%
    );
    border: 1px solid rgba(80, 120, 170, 0.10);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(120, 160, 200, 0.05);
  }
  .content { color: #dce6f0; }
  .content.answer { color: #a8b8ca; }

  .pastel-card.front::before {
    border-top-color: #2d8a9e;
    border-left-color: #2d8a9e;
  }
  .pastel-card.front::after {
    border-bottom-color: #2d5a9e;
    border-right-color: #2d5a9e;
  }
  .pastel-card.back::before {
    border-top-color: #5a5a6a;
    border-right-color: #5a5a6a;
  }
  .pastel-card.back::after {
    border-bottom-color: #e07a3a;
    border-left-color: #e07a3a;
  }

  .pastel-card.front .edge-top    { background: #2d8a9e; }
  .pastel-card.front .edge-bottom { background: #2d5a9e; }
  .pastel-card.back  .edge-top    { background: #5a5a6a; }
  .pastel-card.back  .edge-bottom { background: #e07a3a; }
}

@media (max-width: 600px) {
  .card-wrapper {
    padding: 16px 8%;
  }
  .pastel-card {
    padding: 32px 24px;
    border-radius: 22px;
    min-height: 140px;
  }
  .content { font-size: 19px; }
  .content.answer { font-size: 17px; }

  .pastel-card::before,
  .pastel-card::after {
    width: 50px;
    height: 50px;
    border-width: 3px;
  }

  .pastel-card.front::before { border-top-left-radius: 22px; }
  .pastel-card.front::after  { border-bottom-right-radius: 22px; }
  .pastel-card.back::before  { border-top-right-radius: 22px; }
  .pastel-card.back::after   { border-bottom-left-radius: 22px; }

  .pastel-card .edge-top,
  .pastel-card .edge-bottom {
    width: 64px;
    height: 3px;
  }
}
